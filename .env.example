# ── AI model ──────────────────────────────────────────────────────────────
# Add ONE of these keys for live agents. Leave both empty to run the whole
# workflow in offline Simulation mode.
#   Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
#   Groq: free key at https://console.groq.com/keys (no card; ~1,000 requests/day per model)
GROQ_API_KEY=
#   Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# auto = first key found: Claude, Groq, Gemini (else Simulation). Or force: anthropic | groq | gemini | openai_compat
LLM_PROVIDER=auto
# auto = Live when a key is present, otherwise Simulation. Or force: simulate
HANDOVER_MODE=auto

# Claude settings
HANDOVER_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (Opus 5.5 defaults to medium)
HANDOVER_EFFORT=medium

# Gemini settings: auto = best Flash model your key can use, or pin one (e.g. gemini-3.5-flash)
GEMINI_MODEL=auto
# Groq models (defaults shown): orchestrator, document analysts (round-robin), scanned-page reader
GROQ_AGENT_MODEL=qwen/qwen3.8-27b
GROQ_ANALYST_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Free-tier tokens per minute per model (requests are paced to fit)
GROQ_TPM=8000

# Any other OpenAI-compatible endpoint (OpenRouter, Cerebras, a local Ollama at http://localhost:11434/v1, ...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_VISION_MODEL=
OPENAI_COMPAT_LABEL=

# How many documents the analyst sub-agents read in parallel (4 suits a free Gemini key)
ANALYST_CONCURRENCY=4

# ── Company & counsel (used in drafts and emails) ─────────────────────────
COMPANY_NAME=Aster Robotics
COUNSEL_NAME=Alex Rivera
COUNSEL_EMAIL=counsel@aster-robotics.example
HR_EMAIL=people@aster-robotics.example

# Pin "today" for repeatable demos (YYYY-MM-DD). Empty = real date.
HANDOVER_TODAY=

# ── Document source ───────────────────────────────────────────────────────
# local = the bundled demo Drive in sample_data/demo_drive
# google = your Google Drive (see README → Google Drive setup)
DRIVE_SOURCE=local
GOOGLE_OAUTH_CLIENT_FILE=credentials/google_oauth_client.json
# Optional: only scan this Drive folder ID (empty = whole My Drive)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── Email ─────────────────────────────────────────────────────────────────
# sandbox = nothing leaves your machine; emails land in the in-app Outbox
# smtp    = real delivery through the server below
MAIL_TRANSPORT=sandbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Safety net for live demos: deliver every email to this address instead
MAIL_REDIRECT_ALL_TO=
